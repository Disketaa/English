{
  "name": "english-learning",
  "version": "1.0.0",
  "description": "Modular English learning app",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx",
    "fix": "eslint --fix . && prettier --write \"Source/**/*.{ts,tsx}\" && prettier --write \"Source/**/*.css\"",
    "format": "prettier --write \"Source/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"Source/**/*.{ts,tsx}\"",
    "format:css": "prettier --write \"Source/**/*.css\"",
    "format:css:check": "prettier --check \"Source/**/*.css\"",
    "comments": "node Tools/Comments/CommentAudit.ts",
    "comments:css": "node Tools/Comments/CommentAudit.ts --css",
    "comments:format": "node Tools/Comments/FormatComments.mjs",
    "comments:format:check": "node Tools/Comments/FormatComments.mjs --check",
    "dedup": "node Tools/Dedup/DedupCheck.mjs",
    "perf": "node Tools/Performance/PerfRun.mjs",
    "perf:strict": "node Tools/Performance/PerfRun.mjs --strict",
    "perf:profile": "node Tools/Performance/PerfRun.mjs --profile --coverage",
    "check": "npm run format:check && npm run lint && npm run comments:format:check && npm run format:css:check && npm run dedup && npm run build"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.0.0"
  }
}
